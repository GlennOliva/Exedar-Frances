# Supabase server configuration. Use a secret/service-role key, never a publishable/anon key.
# These variables are server-only and must never use a VITE_ prefix.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SECRET_KEY=replace-with-your-server-secret-key
SUPABASE_PUBLISHABLE_KEY=replace-with-your-publishable-key

# One-time admin seed values. Remove these after running npm run admin:seed.
ADMIN_SEED_EMAIL=replace-with-the-initial-admin-email
ADMIN_SEED_PASSWORD=replace-with-the-one-time-initial-password

# Gmail SMTP. Use a Google App Password, never the account password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your-gmail-address@gmail.com
SMTP_PASS=replace-with-a-16-character-app-password
SMTP_FROM=Exedar and Frances <your-gmail-address@gmail.com>

APP_BASE_URL=http://localhost:5174
TOKEN_SIGNING_SECRET=replace-with-at-least-32-random-characters
SCHEDULER_SECRET=replace-with-a-different-32-character-secret
# Vercel only: set CRON_SECRET to the same value as SCHEDULER_SECRET.
CRON_SECRET=replace-with-the-same-scheduler-secret

# log: no network delivery; test: redirects every message to TEST_EMAIL_TO; production: real recipients
MAIL_DELIVERY_MODE=log
TEST_EMAIL_TO=you@example.com
PORT=3001
TRUST_PROXY=false
